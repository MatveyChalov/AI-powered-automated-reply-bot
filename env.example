# Заполните значения в Replit → Tools → Secrets
BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_TELEGRAM_БОТА
GROQ_API_KEY=ВСТАВЬТЕ_API_КЛЮЧ_GROQ
OWNER_TELEGRAM_ID=ВАШ_ЧИСЛОВОЙ_TELEGRAM_ID

# Необязательные параметры
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_PATH=manager.sqlite3
REPORT_DELAY_SECONDS=45
MAX_HISTORY_MESSAGES=24
